---
import Layout from '../../layouts/Layout.astro';
import {projects} from '../../data/projects';
export function getStaticPaths(){return projects.map((project,i)=>({params:{slug:project.slug},props:{project,next:projects[(i+1)%projects.length],i}}));}
const {project:p,next,i}=Astro.props;
---
<Layout title={`${p.label} — Taimoor Mateen`} description={p.description}><article class="detail section" style={`--project-color:${p.color}`}><div class="detail-top"><a href="/#work">← All selected work</a><span>0{i+1} / {p.category}</span></div><p class="eyebrow">SELECTED PROJECT / {p.label}</p><h1>{p.title}<span style="color:var(--project-color)">.</span></h1><p class="detail-lead">{p.description}</p><a class="button primary magnetic" href={p.url} target="_blank" rel="noopener noreferrer">Visit Live Website ↗</a><div class="detail-visual">{p.image&&<img src={p.image} alt={`Imagery from the ${p.label} demonstration website`} width="1400" height="800"/>}<span>{p.word}</span></div><p class="detail-caption">{p.image?'Editorial presentation using imagery from the live demo. This is not a website screenshot.':'Editorial project illustration. Explore the live site for the actual interface.'}</p><div class="detail-info"><div><p class="eyebrow">THE EXPERIENCE</p><h2>Designed to<br/><i>be explored.</i></h2></div><div><ul>{p.features.map(f=><li>{f}</li>)}</ul>{p.tech.length>0&&<p>Verified technologies: {p.tech.join(' · ')}</p>}<p>{p.slug==='leadpilot'?'Public sign-in interface reviewed. Private workspace behavior and business results are not claimed.':'Self-initiated demonstration project. Brand content and illustrative statistics on the live demo are not client results or endorsements.'}</p></div></div><a class="detail-next" href={`/projects/${next.slug}/`}><div><small>NEXT EXPLORATION</small>{next.title}</div><span>↗</span></a></article></Layout>
