---
import Layout from '../layouts/Layout.astro';
import HeroStudio from '../components/HeroStudio';
import ProfitCalculator from '../components/ProfitCalculator';
import {projects} from '../data/projects';
const services=[['AI-Powered Web Development','Built for your next chapter.','Modern business websites and landing pages that make your offer clear and give visitors a direct route to enquire.','Websites / Landing pages / Frontend'],['Vibe Coding & Creative Websites','An experience worth remembering.','Expressive visual systems, immersive interaction and purposeful motion, shaped with an AI-assisted development process.','Creative direction / 3D / Motion'],['UI/UX & Website Redesign','Clarity at every interaction.','Thoughtful structure, accessible interfaces and responsive layouts that help people find what matters and take the next step.','User journeys / Responsive design / UI'],['Custom Web Applications','Your process. Your product.','Custom tools, dashboards and web applications designed around the work your business actually needs to do.','Web apps / Dashboards / Interfaces']];
---
<Layout>
<section class="hero"><div class="hero-topline"><span>INDEPENDENT CREATIVE DEVELOPER</span><span>WEBSITES / WEB APPS / VIBE CODING</span></div><div class="hero-content"><p class="hero-kicker">TAIMOOR MATEEN / AI-POWERED WEB DEVELOPMENT</p><h1><span class="line">Turning ideas into</span><span class="line"><i>remarkable digital</i></span><span class="line"><i>experiences.</i></span></h1><div class="hero-intro"><p>I create modern websites, interactive experiences and custom web apps that help your business make a stronger first impression.</p><div class="hero-cta-row"><a class="button primary magnetic" href="#work">Explore My Work <span>↘</span></a><a class="button secondary" href="#contact">Let’s Talk <span>↗</span></a></div></div></div><div class="hero-stage"><HeroStudio client:load/></div></section><section class="portfolio-facts"><p class="eyebrow">THE WORK BEHIND THE CRAFT</p><h2>Ideas become <i>experiences.</i></h2><div class="facts-panel"><div><strong>05</strong><span>Selected web projects</span></div><div><strong>04</strong><span>Areas of web expertise</span></div><div><strong>1:1</strong><span>Direct collaboration</span></div></div><p>Self-initiated websites and web app demonstrations. Explore the live work below.</p></section>
<div class="marquee" aria-hidden="true"><div>CREATIVE DEVELOPMENT <b>◆</b> DIGITAL EXPERIENCES <b>◆</b> VIBE CODING <b>✳</b> CREATIVE DEVELOPMENT <b>◆</b> DIGITAL EXPERIENCES <b>◆</b> VIBE CODING <b>✳</b></div></div>
<section class="work section" id="work"><div class="section-intro reveal"><p class="eyebrow">01 / SELECTED WORK</p><h2>Selected websites.<br/><i>Built with purpose.</i><span class="tiny-count">(05)</span></h2><p>A selection of self-initiated websites,<br/>web apps and creative experiments.<br/><span class="muted">Built to explore what’s possible.</span></p></div><div class="project-grid">{projects.map((p,i)=><article class:list={['project','reveal',i%2===1?'project-offset':'']} style={`--project-color:${p.color}`}><a class="project-visual tilt" href={`/projects/${p.slug}/`} aria-label={`Explore ${p.label}`}><div class="preview-top"><span>● ● ●</span><span>{new URL(p.url).hostname}</span><span>↗</span></div>{p.image?<img src={p.image} alt={`Imagery used in the ${p.label} live demo`} loading="lazy" width="1000" height="700"/>:<div class:list={['product-art',p.slug]}><div class="crm-art"><div class="crm-side">L<span>⌂</span><span>☷</span><span>◷</span></div><div class="crm-main"><small>WORKSPACE / OVERVIEW</small><h3>Everything.<br/>Moving forward.</h3><div class="crm-bars"><b></b><b></b><b></b><b></b><b></b><b></b></div></div></div></div>}<div class="preview-overlay"><span>{p.category.split(' · ')[0].toUpperCase()}</span><h3>{p.word}</h3><p>{p.slug==='leadpilot'?'EDITORIAL PROJECT PREVIEW':'PROJECT IMAGERY · EXPLORE THE LIVE DEMO'}</p></div><span class="project-arrow">↗</span></a><div class="project-info"><div><p class="eyebrow">0{i+1} / {p.category}</p><h3><a href={`/projects/${p.slug}/`}>{p.title}</a></h3><p class="project-short">{p.description}</p></div><a class="live-link" href={p.url} target="_blank" rel="noopener noreferrer" aria-label={`Visit ${p.label} live website`}>Visit live ↗</a></div></article>)}</div></section>
<div class="craft-strip"><span>DESIGNED WITH INTENTION.</span><b>Developed to <i>stand out.</i></b><span>✳</span></div><section class="about section" id="about"><div class="about-art reveal" aria-hidden="true"><span class="identity-top">THE PERSON BEHIND THE PIXELS</span><span class="identity-monogram">TM</span><div class="identity-code">&lt;creativity&gt;<br/>&nbsp;&nbsp;curiosity + craft + code<br/>&lt;/creativity&gt;</div><div class="identity-bottom"><span>TAIMOOR<br/>MATEEN</span><b>✳</b></div></div><div class="about-copy"><p class="eyebrow reveal">02 / THE MIND BEHIND THE PIXELS</p><h2 class="reveal">Design, development<br/><i>and the details between.</i></h2><p class="about-lead reveal">I’m Taimoor Mateen.<br/><span class="muted">AI-Powered Web Developer<br/>& Vibe Coding Specialist.</span></p><p class="reveal">I create modern websites, custom web applications, and intelligent digital experiences using modern frontend technologies and AI-assisted development.</p><p class="reveal">From the first interaction to the smallest detail, I bring design and development together to make ambitious ideas feel effortless.</p><a class="text-link reveal" href="#contact">Let’s create something meaningful <span>↗</span></a></div></section>
<section class="services section" id="services"><div class="section-intro reveal"><p class="eyebrow">03 / WHAT I BRING TO THE TABLE</p><h2>Expertise built<br/><i>around your goals.</i></h2><p>Distinctive websites.<br/>Immersive digital experiences.</p></div><div class="service-list">{services.map((s,i)=><details class="service reveal" open={i===0}><summary><span class="service-number">0{i+1}</span><h3>{s[0]}</h3><span class="service-toggle">+</span></summary><div class="service-body"><div class="service-symbol" aria-hidden="true">{['✳','◈','◎','⌘','⤴'][i]}</div><div><h4>{s[1]}</h4><p>{s[2]}</p><span class="eyebrow">{s[3]}</span></div><a class="text-link" href="#contact">Discuss a project ↗</a></div></details>)}</div></section>
<section class="benefits section" id="benefits"><div class="section-intro reveal"><p class="eyebrow">04 / THE BUSINESS SIDE</p><h2>Better experiences.<br/><i>Clearer business value.</i></h2><p>A website should support your business.<br/>Explore the numbers behind the idea.</p></div><div class="benefit-cards"><article class="reveal"><span>01 / GET FOUND</span><h3>One home.<br/>For your whole brand.</h3><p>Give visitors a clear place to understand your offer, explore your work and make an enquiry.</p></article><article class="reveal"><span>02 / MAKE IT CLEAR</span><h3>Less friction.<br/>A clearer next step.</h3><p>Thoughtful structure, responsive design and focused calls to action help visitors move from interest to enquiry.</p></article><article class="reveal"><span>03 / THINK IN VALUE</span><h3>See the potential.<br/>Check the maths.</h3><p>Use your own traffic, sales and margin assumptions to estimate what additional enquiries could be worth.</p></article></div><div class="profit-intro reveal"><h3>What could a better website be worth?</h3><p>Example: 1,000 monthly visitors, an assumed enquiry-rate change from 1% to 3%, a 20% close rate, $500 average sale and 40% gross margin. After $100 in monthly website operating cost, the scenario produces <strong>$700 incremental monthly profit</strong>, before the excluded costs below.</p></div><ProfitCalculator client:load/></section><section class="process section"><p class="eyebrow reveal">05 / FROM WHAT IF TO WHAT’S NEXT</p><div class="process-title reveal"><h2>Great work starts<br/>with <i>understanding.</i></h2><p>A clear, collaborative path<br/>from idea to launch.</p></div><div class="process-grid">{[['Discover','Your goals, your audience, the right problem to solve.'],['Shape','A visual direction and experience with a clear purpose.'],['Build','Thoughtful development, interaction and refinement.'],['Launch','Responsive checks, final polish and a considered handover.']].map((s,i)=><div class="reveal"><span>0{i+1} /</span><h3>{s[0]}</h3><p>{s[1]}</p></div>)}</div></section>
<section class="faqs section" id="faqs"><div class="section-intro reveal"><p class="eyebrow">BEFORE WE START</p><h2>Before we<br/><i>work together.</i></h2><p>A few practical details<br/>about starting a project.</p></div><div class="faq-list">{[['What can you build for my business?','Business websites, landing pages, creative interactive experiences, redesigns and custom web applications. We can agree the scope around your audience, goals and content.'],['Will my website work on mobile?','Responsive layouts are part of the build, with interfaces adapted for desktop, tablet and mobile devices.'],['Are these real client case studies?','The selected work here consists of self-initiated demonstration projects. They show the interfaces and ideas I can build; they are not claims of client revenue or results.'],['How do we start a project?','Share your idea, existing website if you have one, desired pages and timeline. Message me on WhatsApp, email me, use the Upwork link or prepare a brief in the form below. Communication is by text and email.']].map(([q,a],i)=><details class="faq-item reveal" open={i===0}><summary>{q}<span aria-hidden="true">+</span></summary><p>{a}</p></details>)}</div></section><section class="contact section" id="contact"><div class="contact-halo" aria-hidden="true"></div><p class="eyebrow reveal"><span class="status"></span> 06 / LET’S MAKE IT HAPPEN</p><h2 class="reveal">Let’s build your next<br/><i>digital experience.</i><span class="contact-asterisk">✳</span></h2><div class="contact-bottom"><div class="reveal"><p>Tell me what you’re imagining.<br/>Let’s find the right way to bring it to life.</p><div class="contact-channels"><a class="button primary" href="https://wa.me/923024058133" target="_blank" rel="noopener noreferrer">WhatsApp Me <span>↗</span></a><a class="button secondary" href="mailto:taimoormateen80@gmail.com">Email Me <span>↗</span></a><a class="text-link" href="https://www.upwork.com/freelancers/~0140fb2d4324cae6a4?mp_source=share" target="_blank" rel="noopener noreferrer">Upwork <span>↗</span></a></div><div class="contact-details"><a href="https://wa.me/923024058133" target="_blank" rel="noopener noreferrer"><span>WhatsApp</span>0302 4058133</a><a href="mailto:taimoormateen80@gmail.com"><span>Email</span>taimoormateen80@gmail.com</a></div><p class="contact-note">Remote collaboration · Text & email communication</p></div><form id="brief-form" class="brief-form reveal"><h3>Shape your project brief</h3><label>Your name<input name="name" autocomplete="name" required placeholder="How should I address you?" maxlength="100"/></label><label>Email<input name="email" type="email" autocomplete="email" required placeholder="you@company.com" maxlength="200"/></label><label>What would you like to build?<textarea name="message" rows="3" required minlength="10" maxlength="3000" placeholder="The idea, the goal, and your timeline…"></textarea></label><button class="text-link" type="submit">Copy brief for Upwork <span>↗</span></button><p class="form-note">This copies your brief so you can paste it into Upwork. Nothing is sent or stored.</p><p class="form-status" role="status" aria-live="polite"></p></form></div></section>
</Layout>
